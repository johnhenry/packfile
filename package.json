{
  "name": "@johnhenry/packfile",
  "version": "0.1.0",
  "type": "module",
  "main": "index.mjs",
  "types": "./types.d.ts",
  "bin": {
    "packfile": "packfile.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/packfile.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/packfile/issues"
  },
  "homepage": "https://opensource.johnhenry.me/packfile/",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "test": "node --test test.mjs test/*.test.mjs",
    "typecheck": "tsc --project test/types-fixture/tsconfig.json",
    "demo:compile": "node demo/compile.mjs",
    "demo:server": "node demo/server.mjs",
    "demo:browser": "npx serve ."
  },
  "keywords": [],
  "author": "John Henry",
  "license": "MIT",
  "description": "Content-addressed static-file archiver and in-memory HTTP router",
  "dependencies": {
    "@johnhenry/andbox": "^0.0.2",
    "es-module-lexer": "^3.0.3",
    "wbn": "^0.0.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "theres-waldo": "^0.0.0",
    "typescript": "^7.0.2",
    "wbn-sign": "^0.3.1"
  },
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.mjs"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "default": "./browser.mjs"
    },
    "./compat": {
      "types": "./compat.d.ts",
      "default": "./compat.mjs"
    },
    "./cache": {
      "types": "./cache.d.ts",
      "default": "./cache.mjs"
    },
    "./hash": {
      "types": "./lib/hash.d.ts",
      "default": "./lib/hash.mjs"
    },
    "./compression": {
      "types": "./lib/compression.d.ts",
      "default": "./lib/compression.mjs"
    },
    "./blob-preview": {
      "types": "./blob-preview.d.ts",
      "default": "./lib/blob-preview.mjs"
    },
    "./web-bundle": {
      "types": "./lib/web-bundle.d.ts",
      "default": "./lib/web-bundle.mjs"
    }
  },
  "files": [
    "index.mjs",
    "browser.mjs",
    "browser.d.ts",
    "compat.mjs",
    "compat.d.ts",
    "cache.mjs",
    "cache.d.ts",
    "packfile.mjs",
    "lib/",
    "blob-preview.d.ts",
    "types.d.ts",
    "types.ts",
    "README.md",
    "LICENSE"
  ]
}
